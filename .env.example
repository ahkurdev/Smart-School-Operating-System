# =============================================================================
# Smart School Operating System - environment template
# Copy to .env and fill in. NEVER commit real secrets.
# =============================================================================

# --- Database (any standard PostgreSQL works: local, Neon, RDS, Cloud SQL, ...) ---
# Local dev uses the portable postgres in .pgsql/ on port 5433 (see scripts/pg.sh).
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/smart_school?schema=public"

# --- App ---
NODE_ENV="development"
APP_URL="http://localhost:3000"
# Base domain used to resolve tenant subdomains (e.g. demo.localhost)
APP_ROOT_DOMAIN="localhost:3000"

# --- Session / crypto secrets (generate with: openssl rand -base64 32) ---
SESSION_SECRET="change-me-to-a-random-32-byte-base64-string"
ATTENDANCE_SIGNING_KEY="change-me-to-a-random-32-byte-base64-string"
# Key used to encrypt sensitive at-rest fields (32 bytes, base64)
ENCRYPTION_KEY="change-me-to-a-random-32-byte-base64-string"

# --- Attendance QR ---
ATTENDANCE_TOKEN_TTL_SECONDS="30"
ATTENDANCE_CLOCK_TOLERANCE_SECONDS="5"

# --- File storage: local | s3 ---
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./.storage"
# For s3 / S3-compatible (AWS S3, Cloudflare R2, MinIO, Backblaze B2):
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# --- AI provider (OpenAI-compatible; provider-agnostic) ---
AI_PROVIDER="openai-compatible"
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_MAX_TOOL_CALLS="6"

# --- Email (provider abstraction; smtp or console in dev) ---
EMAIL_PROVIDER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@example.edu"

# --- Background jobs ---
JOB_QUEUE_DRIVER="inline"

# --- Observability (optional) ---
LOG_LEVEL="info"
