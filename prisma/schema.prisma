  @@index([tenantId, category])
  @@index([tenantId, condition])
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  BROKEN
  DISPOSED
}

model AssetMaintenance {
  id          String    @id @default(cuid())
  tenantId    String
  assetId     String
