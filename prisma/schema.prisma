// Smart School Operating System - Prisma schema
// Modular monolith. Shared-schema multi-tenancy: every tenant-scoped model has tenantId.
// ID strategy: cuid() for portability and scale; opaque, no collision, sortable enough.
//
// Naming: models PascalCase, fields camelCase, enums SCREAMING_SNAKE values.
// Every tenant-scoped model indexes (tenantId, ...) for the real query shapes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// TENANCY & IDENTITY
// ============================================================================

model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  legalName String?
  type      TenantType   @default(SCHOOL)
  status    TenantStatus @default(ACTIVE)

  // Configuration (all customizable; nothing about a specific school is hardcoded)
  timezone     String  @default("UTC")
  locale       String  @default("en")
  currency     String  @default("USD")
  primaryColor String  @default("#0f766e")
  logoUrl      String?

  // Academic configuration
  gradeLabel           String @default("Grade")
  classLabel           String @default("Class")
  studentIdLabel       String @default("Student ID")
  academicTermsPerYear Int    @default(2)
  gradingScale         Json   @default("{\"type\":\"numeric\",\"min\":0,\"max\":100,\"pass\":60}")

  // Feature flags (modules can be turned on/off per tenant)
  featureFlags Json @default("{\"admission\":true,\"library\":true,\"finance\":true,\"ai\":true,\"counseling\":true,\"discipline\":true,\"facility\":true,\"extracurricular\":true}")

  settings Json @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  campuses      Campus[]
  roles         Role[]
  memberships   Membership[]
  academicYears AcademicYear[]
  students      Student[]
  teachers      Teacher[]
  guardians     Guardian[]
  gradeLevels   GradeLevel[]
  subjects      Subject[]
  classes       Classroom[]
  departments   Department[]

  auditLogs       AuditLog[]
  settingsRows    SystemSetting[]
  apiKeys         ApiKey[]
  webhooks        Webhook[]
  aiConversations AIConversation[]

  @@index([status])
  @@index([slug])
}

enum TenantType {
  SCHOOL
  DISTRICT
  INSTITUTE
  UNIVERSITY
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Campus {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code       String
  name       String
  address    String?
  city       String?
  region     String?
  country    String?
  postalCode String?
  phone      String?
  email      String?
  timezone   String?
  isPrimary  Boolean      @default(false)
  status     TenantStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  classes            Classroom[]
  students           Student[]
  teachers           Teacher[]
  rooms              Room[]
  attendanceSessions AttendanceSession[]
  assets             Asset[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  username      String?   @unique
  emailVerified DateTime?
  phone         String?

  passwordHash       String
  mustChangePassword Boolean @default(false)

  // Profile
  fullName      String
  preferredName String?
  avatarFileId  String?
  address       String?
  locale        String?
  timezone      String?

  // Status & security
  status           UserStatus @default(ACTIVE)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  lastLoginIp      String?

  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  notificationPrefs Json @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships      Membership[]
  sessions         Session[]
  loginHistory     LoginAttempt[]
  passwordResetTokens PasswordResetToken[]
  studentProfile   Student?
  teacherProfile   Teacher?
  guardianProfile  Guardian?
  applicantProfile Applicant?

  authoredAnnouncements Announcement[]
  auditLogs             AuditLog[]
  aiConversations       AIConversation[]
  uploadedFiles         FileObject[]     @relation("UploadedBy")

  @@index([status])
  @@index([email])
  @@index([username])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

// A person's role within a tenant. A user can belong to many tenants.
model Membership {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status MembershipStatus @default(ACTIVE)
  title  String? // display title, e.g. "Vice Principal"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles UserRole[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, status])
}

enum MembershipStatus {
  ACTIVE
  INVITED
  INACTIVE
}

model Role {
  id       String  @id @default(cuid())
  tenantId String? // null = built-in system role template
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key         String // machine key, e.g. "teacher", "school_admin"
  name        String // display name
  description String?
  isSystem    Boolean @default(false) // system roles cannot be deleted
  isDefault   Boolean @default(false) // auto-assigned on membership creation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // "student.read"
  subject     String // "student"
  action      String // "read"
  category    String // "People"
  description String?

  rolePermissions RolePermission[]

  @@index([subject])
  @@index([category])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([membershipId, roleId])
  @@index([roleId])
}

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash      String  @unique
  activeTenantId String?
  ipAddress      String?
  userAgent      String?
  deviceLabel    String?

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  identifier String
  success    Boolean
  ipAddress  String?
  userAgent  String?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([userId])
}

/// One-time password reset token. Only the hash is stored; the raw token is
/// delivered out-of-band (email) and consumed once.
model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================================
// ACADEMIC STRUCTURE
// ============================================================================

model AcademicYear {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String // "2026/2027"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean            @default(false)
  status    AcademicYearStatus @default(PLANNED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  terms              AcademicTerm[]
  enrollments        Enrollment[]
  classes            Classroom[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]
  admissionPeriods   AdmissionPeriod[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

enum AcademicYearStatus {
  PLANNED
  ACTIVE
  CLOSED
}

model AcademicTerm {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  name      String // "Semester 1", "Term 1", "Quarter 3"
  type      TermType @default(SEMESTER)
  startDate DateTime
  endDate   DateTime
  sequence  Int      @default(1)
  isCurrent Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessments Assessment[]
  reportCards ReportCard[]

  @@unique([academicYearId, sequence])
  @@index([academicYearId])
}

enum TermType {
  SEMESTER
  TRIMESTER
  QUARTER
  TERM
  CUSTOM
}

model GradeLevel {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String // "Grade 10", "Year 11", "Kelas 10"
  code     String
  sequence Int
  stage    String? // "Primary", "Secondary"
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes Classroom[]

  @@unique([tenantId, code])
  @@index([tenantId, sequence])
}

model Department {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String // "Science", "Languages"
  code        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects Subject[]
  teachers Teacher[]

  @@unique([tenantId, code])
}

model Subject {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  code               String
  name               String
  description        String?
  credits            Int     @default(1)
  isActive           Boolean @default(true)
  learningObjectives String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherAssignments TeacherAssignment[]
  assessments        Assessment[]
  assignments        Assignment[]
  learningMaterials  LearningMaterial[]
  timetableEntries   TimetableEntry[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model Curriculum {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  code        String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

model Classroom {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campusId       String?
  campus         Campus?       @relation(fields: [campusId], references: [id], onDelete: SetNull)
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  gradeLevelId   String?
  gradeLevel     GradeLevel?   @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)

  name              String // "10-A", "Grade 5 Mawar"
  code              String
  stream            String? // "Science", "Social" (configurable, not hardcoded)
  capacity          Int      @default(30)
  homeroomTeacherId String?
  homeroomTeacher   Teacher? @relation(fields: [homeroomTeacherId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]
  attendanceSessions AttendanceSession[]
  timetableEntries   TimetableEntry[]
  assignments        Assignment[]
  assessments        Assessment[]
  announcements      ClassAnnouncementLink[]

  @@unique([tenantId, code])
  @@index([tenantId, academicYearId])
  @@index([tenantId, gradeLevelId])
}

model Room {
  id       String  @id @default(cuid())
  tenantId String
  campusId String?
  campus   Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  code       String
  name       String
  type       RoomType @default(CLASSROOM)
  capacity   Int      @default(30)
  location   String?
  facilities Json     @default("[]")
  isActive   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timetableEntries   TimetableEntry[]
  facilityBookings   FacilityBooking[]
  attendanceSessions AttendanceSession[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
}

enum RoomType {
  CLASSROOM
  LABORATORY
  LIBRARY
  HALL
  OFFICE
  SPORTS
  OTHER
}

model Enrollment {
  id             String       @id @default(cuid())
  tenantId       String
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId    String
  classroom      Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  rollNumber Int?
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  leftAt     DateTime?
  leftReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId])
  @@index([tenantId, classroomId])
  @@index([tenantId, academicYearId, status])
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  GRADUATED
  WITHDRAWN
  SUSPENDED
}

model TeacherAssignment {
  id             String    @id @default(cuid())
  tenantId       String
  teacherId      String
  teacher        Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classroomId    String
  classroom      Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  academicYearId String

  isPrimary Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, subjectId, classroomId, academicYearId])
  @@index([tenantId, classroomId])
  @@index([tenantId, teacherId])
}

// ============================================================================
// PEOPLE
// ============================================================================

model Student {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  campusId String?
  campus   Campus? @relation(fields: [campusId], references: [id], onDelete: SetNull)

  studentNumber String
  nationalId    String?
  fullName      String
  preferredName String?
  photoFileId   String?
  gender        String?

  birthDate   DateTime?
  birthPlace  String?
  nationality String?
  religion    String?

  address    String?
  city       String?
  region     String?
  country    String?
  postalCode String?

  email String?
  phone String?

  emergencyContactName  String?
  emergencyContactPhone String?

  medicalNotes   String?
  specialEdNotes String?

  admissionDate  DateTime?
  graduationDate DateTime?
  status         StudentStatus @default(ACTIVE)

  customFields Json @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  guardians           StudentGuardian[]
  enrollments         Enrollment[]
  attendanceRecords   AttendanceRecord[]
  submissions         AssignmentSubmission[]
  grades              Grade[]
  reportCards         ReportCard[]
  invoices            Invoice[]
  libraryLoans        LibraryLoan[]
  extracurriculars    ExtracurricularMember[]
  achievements        Achievement[]
  disciplineRecords   DisciplineRecord[]
  counselingRecords   CounselingRecord[]
  documents           Document[]
  libraryReservations LibraryReservation[]
  originApplicant     Applicant?

  @@unique([tenantId, studentNumber])
  @@index([tenantId, status])
  @@index([tenantId, fullName])
  @@index([tenantId, campusId])
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
  APPLICANT
}

model Teacher {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String?     @unique
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  campusId     String?
  campus       Campus?     @relation(fields: [campusId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  employeeNumber String
  fullName       String
  photoFileId    String?
  gender         String?

  qualification  String?
  specialization String?
  employmentType EmploymentType @default(FULL_TIME)
  joinDate       DateTime?
  exitDate       DateTime?

  email   String?
  phone   String?
  address String?

  status       StaffStatus @default(ACTIVE)
  customFields Json        @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  assignments        TeacherAssignment[]
  attendanceRecords  AttendanceRecord[]
  timetableEntries   TimetableEntry[]
  attendanceSessions AttendanceSession[]
  homeroomClasses    Classroom[]
  documents          Document[]

  @@unique([tenantId, employeeNumber])
  @@index([tenantId, status])
  @@index([tenantId, fullName])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  VOLUNTEER
  SUBSTITUTE
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  TERMINATED
}

model Staff {
  id             String      @id @default(cuid())
  tenantId       String
  userId         String?
  fullName       String
  employeeNumber String
  position       String
  department     String?
  phone          String?
  email          String?
  joinDate       DateTime?
  status         StaffStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, employeeNumber])
  @@index([tenantId, status])
}

model Guardian {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  fullName     String
  relationship String
  nationalId   String?
  occupation   String?
  phone        String?
  email        String?
  address      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  students StudentGuardian[]
  invoices Invoice[]

  @@index([tenantId, fullName])
  @@index([tenantId, relationship])
}

model StudentGuardian {
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId String
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  relationship    String
  isPrimary       Boolean @default(false)
  canPickup       Boolean @default(true)
  hasPortalAccess Boolean @default(true)

  createdAt DateTime @default(now())

  @@id([studentId, guardianId])
  @@index([guardianId])
}

// ============================================================================
// ATTENDANCE
// ============================================================================

model AttendanceSession {
  id             String        @id @default(cuid())
  tenantId       String
  campusId       String?
  campus         Campus?       @relation(fields: [campusId], references: [id], onDelete: SetNull)
  classroomId    String?
  classroom      Classroom?    @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  subjectId      String?
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  teacherId      String?
  teacher        Teacher?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  roomId         String?
  room           Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)

  title              String?
  sessionDate        DateTime
  startAt            DateTime
  endAt              DateTime
  gracePeriodMinutes Int      @default(10)

  latitude     Float?
  longitude    Float?
  radiusMeters Int?

  status AttendanceSessionStatus @default(SCHEDULED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records AttendanceRecord[]
  tokens  AttendanceToken[]

  @@index([tenantId, sessionDate])
  @@index([tenantId, status])
  @@index([tenantId, classroomId])
}

enum AttendanceSessionStatus {
  SCHEDULED
  OPEN
  CLOSED
  CANCELLED
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  tenantId  String
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  status   AttendanceStatus
  method   AttendanceMethod @default(QR)
  scanTime DateTime         @default(now())

  tokenId            String?
  overriddenByUserId String?
  overrideReason     String?
  overriddenAt       DateTime?

  createdAt DateTime @default(now())

  @@unique([sessionId, studentId])
  @@unique([sessionId, teacherId])
  @@index([tenantId, status])
  @@index([studentId, sessionId])
}

enum AttendanceStatus {
  PRESENT
  LATE
  EXCUSED
  SICK
  ABSENT
  LEAVE
}

enum AttendanceMethod {
  QR
  MANUAL
  IMPORT
  SYSTEM
}

model AttendanceToken {
  id        String             @id @default(cuid())
  tenantId  String
  sessionId String?
  session   AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  studentId String

  nonce            String    @unique
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime
  consumedAt       DateTime?
  consumedByUserId String?

  @@index([studentId, expiresAt])
  @@index([tenantId, expiresAt])
}

// ============================================================================
// TIMETABLE
// ============================================================================

model SchedulePeriod {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  sequence  Int
  startTime String
  endTime   String
  isBreak   Boolean @default(false)

  createdAt DateTime @default(now())

  timetableEntries TimetableEntry[]

  @@unique([tenantId, sequence])
}

model TimetableEntry {
  id             String          @id @default(cuid())
  tenantId       String
  academicYearId String
  classroomId    String
  classroom      Classroom       @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId      String?
  teacher        Teacher?        @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  roomId         String?
  room           Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  periodId       String?
  period         SchedulePeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  dayOfWeek     Int
  startTime     String
  endTime       String
  isRecurring   Boolean   @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, academicYearId, dayOfWeek])
  @@index([tenantId, teacherId, dayOfWeek])
  @@index([tenantId, roomId, dayOfWeek])
}

model Holiday {
  id       String      @id @default(cuid())
  tenantId String
  name     String
  date     DateTime
  endDate  DateTime?
  type     HolidayType @default(PUBLIC)

  createdAt DateTime @default(now())

  @@index([tenantId, date])
