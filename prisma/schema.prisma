  approvedByUserId  String?

  createdAt DateTime @default(now())

  @@index([tenantId, status])
  @@index([facilityId, startAt])
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

