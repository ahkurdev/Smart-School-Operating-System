  EXAM
  BREAK
  OTHER
}

// ============================================================================
// ASSIGNMENTS, ASSESSMENTS, GRADES
// ============================================================================

model Assignment {
  id          String    @id @default(cuid())
  tenantId    String
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId   String?

  title             String
  instructions      String?
  attachmentFileId  String?
  dueAt             DateTime?
  maxScore          Float         @default(100)
  allowResubmission Boolean       @default(false)
  status            PublishStatus @default(DRAFT)
  publishedAt       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  submissions AssignmentSubmission[]

  @@index([tenantId, classroomId, status])
  @@index([tenantId, dueAt])
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  tenantId     String
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  content     String?
  fileId      String?
  submittedAt DateTime @default(now())

  score          Float?
  feedback       String?
  gradedAt       DateTime?
  gradedByUserId String?
  status         SubmissionStatus @default(SUBMITTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, studentId])
  @@index([tenantId, studentId])
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
  RETURNED
  RESUBMITTED
}

model Assessment {
  id             String        @id @default(cuid())
  tenantId       String
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  termId         String?
  term           AcademicTerm? @relation(fields: [termId], references: [id], onDelete: SetNull)
  classroomId    String
  classroom      Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  title       String
  type        AssessmentType @default(EXAM)
  maxScore    Float          @default(100)
  weight      Float          @default(1)
  scheduledAt DateTime?
  status      PublishStatus  @default(DRAFT)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  grades          Grade[]
  gradeComponents GradeComponent[]

  @@index([tenantId, classroomId, termId])
}

enum AssessmentType {
  ASSIGNMENT
  QUIZ
  EXAM
  PROJECT
  PARTICIPATION
  CUSTOM
}

model GradeComponent {
  id           String      @id @default(cuid())
  tenantId     String
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  name         String
  weight       Float       @default(1)
  maxScore     Float       @default(100)

  createdAt DateTime @default(now())

  @@index([tenantId, assessmentId])
}

model Grade {
  id           String     @id @default(cuid())
  tenantId     String
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  score       Float?
  letterGrade String?
  remarks     String?
  status      GradeStatus @default(DRAFT)

  enteredByUserId  String?
  submittedAt      DateTime?
  approvedByUserId String?
  publishedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, studentId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

enum GradeStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PUBLISHED
}

model ReportCard {
  id             String        @id @default(cuid())
  tenantId       String
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String
  termId         String?
  term           AcademicTerm? @relation(fields: [termId], references: [id], onDelete: SetNull)
  classroomId    String?

  grades            Json             @default("[]")
  attendanceSummary Json             @default("{}")
  teacherRemarks    String?
  principalRemarks  String?
  status            ReportCardStatus @default(DRAFT)
  publishedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId, termId])
  @@index([tenantId, status])
}

enum ReportCardStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

model LearningMaterial {
  id          String  @id @default(cuid())
  tenantId    String
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classroomId String?
  teacherId   String?

  title       String
  description String?
  type        MaterialType  @default(DOCUMENT)
  url         String?
  fileId      String?
  unit        String?
  topic       String?
  status      PublishStatus @default(DRAFT)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId, subjectId, status])
}

enum MaterialType {
  TEXT
  DOCUMENT
  SLIDES
  LINK
  VIDEO
}

model Exam {
  id             String  @id @default(cuid())
  tenantId       String
  academicYearId String
  termId         String?
  classroomId    String?
  subjectId      String?

  title            String
  description      String?
  startAt          DateTime
  endAt            DateTime
  roomId           String?
  proctorTeacherId String?
  status           ExamStatus @default(SCHEDULED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ExamParticipant[]

  @@index([tenantId, startAt])
}

enum ExamStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

model ExamParticipant {
  id         String  @id @default(cuid())
  tenantId   String
  examId     String
  exam       Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId  String
  seatNumber String?
  score      Float?
  remarks    String?

  @@unique([examId, studentId])
  @@index([tenantId])
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

