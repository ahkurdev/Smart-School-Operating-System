  description    String?
  coachTeacherId String?
  schedule       String?
  location       String?
  capacity       Int?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      ExtracurricularMember[]
  achievements Achievement[]

  @@index([tenantId, isActive])
}

model ExtracurricularMember {
  id                String          @id @default(cuid())
  tenantId          String
  extracurricularId String
  extracurricular   Extracurricular @relation(fields: [extracurricularId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  role              String?
  joinedAt          DateTime        @default(now())
  isActive          Boolean         @default(true)

  @@unique([extracurricularId, studentId])
  @@index([tenantId])
}

model Achievement {
  id                String           @id @default(cuid())
  tenantId          String
  studentId         String?
  student           Student?         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId         String?
  extracurricularId String?
  extracurricular   Extracurricular? @relation(fields: [extracurricularId], references: [id], onDelete: SetNull)

  title          String
  competition    String?
  level          AchievementLevel @default(SCHOOL)
  rank           String?
  achievedAt     DateTime
  evidenceFileId String?
  publishToCms   Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([tenantId, level])
}

enum AchievementLevel {
  SCHOOL
  DISTRICT
  REGIONAL
  NATIONAL
  INTERNATIONAL
}

// ============================================================================
// COUNSELING & DISCIPLINE
// ============================================================================

model CounselingRecord {
  id              String           @id @default(cuid())
  tenantId        String
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  counselorUserId String?
  type            CounselingType   @default(SESSION)
  scheduledAt     DateTime?
  occurredAt      DateTime         @default(now())
  summary         String
  notes           String?
  followUpAt      DateTime?
  status          CounselingStatus @default(OPEN)
  // High-sensitivity: access restricted to counselor + authorized roles
  confidential    Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([studentId])
}

enum CounselingType {
  APPOINTMENT
  SESSION
  REFERRAL
  FOLLOW_UP
}

enum CounselingStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

model DisciplineRecord {
  id               String  @id @default(cuid())
  tenantId         String
  studentId        String
  student          Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reportedByUserId String?

  category    String
  description String
  occurredAt  DateTime
  severity    DisciplineSeverity @default(MINOR)
  action      String?
  followUpAt  DateTime?
  status      DisciplineStatus   @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([studentId])
}

enum DisciplineSeverity {
  MINOR
  MODERATE
  MAJOR
  CRITICAL
}

enum DisciplineStatus {
  OPEN
  RESOLVED
  APPEALED
  CLOSED
}

// ============================================================================
// DOCUMENTS & FILES
// ============================================================================

model FileObject {
  id               String  @id @default(cuid())
  tenantId         String?
  key              String  @unique // opaque storage key
  bucket           String?
  provider         String  @default("local")
  fileName         String
  mimeType         String
  size             Int
  checksum         String?
  isPublic         Boolean @default(false)
  uploadedByUserId String?
  uploadedBy       User?   @relation("UploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  documents Document[]

  @@index([tenantId])
  @@index([uploadedByUserId])
}

model Document {
  id       String     @id @default(cuid())
  tenantId String
  fileId   String
  file     FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)

  title     String
  category  String
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  accessLevel      DocumentAccess @default(RESTRICTED)
  expiresAt        DateTime?
  uploadedByUserId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId, category])
  @@index([studentId])
}

enum DocumentAccess {
  PUBLIC
  STAFF
  RESTRICTED
  PRIVATE
}

// ============================================================================
// COMMUNICATION
// ============================================================================

model Announcement {
  id           String               @id @default(cuid())
  tenantId     String
  title        String
  body         String
  priority     AnnouncementPriority @default(NORMAL)
  audience     AnnouncementAudience @default(ALL)
  authorUserId String?
  author       User?                @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  status                 PublishStatus @default(DRAFT)
  publishAt              DateTime?
  expireAt               DateTime?
  requiresAcknowledgment Boolean       @default(false)
  attachmentFileId       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  classLinks      ClassAnnouncementLink[]
  acknowledgments AnnouncementAcknowledgment[]

  @@index([tenantId, status, publishAt])
  @@index([tenantId, audience])
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AnnouncementAudience {
  ALL
  STUDENTS
  TEACHERS
  PARENTS
  STAFF
  CLASS
  GRADE
  CUSTOM
}

model ClassAnnouncementLink {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  classroomId    String
  classroom      Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@id([announcementId, classroomId])
}

model AnnouncementAcknowledgment {
  id             String       @id @default(cuid())
  tenantId       String
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([tenantId])
}

model Notification {
  id       String              @id @default(cuid())
  tenantId String
  userId   String
  type     String
  title    String
  body     String?
  link     String?
  channel  NotificationChannel @default(IN_APP)
  readAt   DateTime?
  sentAt   DateTime?
  status   NotificationStatus  @default(PENDING)
  metadata Json                @default("{}")

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([tenantId, status])
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

model MessageThread {
  id              String            @id @default(cuid())
  tenantId        String
  subject         String?
  type            MessageThreadType @default(DIRECT)
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  participants MessageParticipant[]
  messages     Message[]

  @@index([tenantId])
}

enum MessageThreadType {
  DIRECT
  TEACHER_STUDENT
  TEACHER_PARENT
  ADMIN_BROADCAST
  SUPPORT
}

model MessageParticipant {
  threadId   String
  thread     MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  role       String?
  lastReadAt DateTime?
  muted      Boolean       @default(false)

  @@id([threadId, userId])
  @@index([userId])
}

model Message {
  id               String        @id @default(cuid())
  tenantId         String
  threadId         String
  thread           MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUserId     String
  body             String
  attachmentFileId String?
  createdAt        DateTime      @default(now())
  editedAt         DateTime?
  deletedAt        DateTime?

  @@index([threadId, createdAt])
}

// ============================================================================
// AI
// ============================================================================

model AIConversation {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  context   String   @default("admin") // admin | teacher | student | parent
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AIMessage[]

  @@index([tenantId, userId])
}

model AIMessage {
  id             String         @id @default(cuid())
  tenantId       String
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | system | tool
  content        String
  model          String?
  tokenIn        Int?
  tokenOut       Int?
  latencyMs      Int?
  createdAt      DateTime       @default(now())

  toolCalls AIToolCall[]

  @@index([conversationId, createdAt])
}

model AIToolCall {
  id            String    @id @default(cuid())
  tenantId      String
  messageId     String
  message       AIMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  toolName      String
  arguments     Json      @default("{}")
  resultSummary String?
  succeeded     Boolean   @default(true)
  latencyMs     Int?
  createdAt     DateTime  @default(now())

  @@index([tenantId, toolName])
}

model AIUsage {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  model     String
  tokenIn   Int      @default(0)
  tokenOut  Int      @default(0)
  cost      Float    @default(0)
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ============================================================================
// INTEGRATIONS
// ============================================================================

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  prefix     String
  scopes     String[]  @default([])
  rateLimit  Int       @default(1000)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Webhook {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String
  events    String[] @default([])
  secret    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([tenantId])
}

model WebhookDelivery {
  id           String                @id @default(cuid())
  tenantId     String
  webhookId    String
  webhook      Webhook               @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payload      Json
  status       WebhookDeliveryStatus @default(PENDING)
  responseCode Int?
  attempts     Int                   @default(0)
  lastError    String?
  nextRetryAt  DateTime?
  createdAt    DateTime              @default(now())

  @@index([tenantId, status])
  @@index([webhookId])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

model BackgroundJob {
  id          String    @id @default(cuid())
  tenantId    String?
  queue       String    @default("default")
  name        String
  payload     Json      @default("{}")
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAt       DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  lastError   String?
  result      Json?

  createdAt DateTime @default(now())

  @@index([status, runAt])
  @@index([tenantId])
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

// ============================================================================
// SYSTEM
// ============================================================================

model AuditLog {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorType   String  @default("user") // user | system | api_key | ai

  action     String // "student.update", "grade.publish"
  resource   String // "Student"
  resourceId String?

  before   Json?
  after    Json?
  metadata Json  @default("{}")

  ipAddress String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([resource, resourceId])
  @@index([actorUserId, createdAt])
  @@index([action])
}

model SystemSetting {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  category  String   @default("general")
  isPublic  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([category])
}

model CustomField {
  id       String  @id @default(cuid())
  tenantId String
  entity   String // "Student" | "Teacher" | "Applicant"
  key      String
  label    String
  type     String  @default("text")
  options  Json    @default("[]")
  required Boolean @default(false)
  sequence Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  values CustomFieldValue[]

  @@unique([tenantId, entity, key])
}

model CustomFieldValue {
  id            String      @id @default(cuid())
  tenantId      String
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  entityId      String
  value         Json

  @@unique([customFieldId, entityId])
  @@index([tenantId, entityId])
}

model DataRetentionPolicy {
  id            String  @id @default(cuid())
  tenantId      String?
  entity        String
  retentionDays Int
  action        String  @default("anonymize") // anonymize | delete | archive
  isActive      Boolean @default(true)

  @@unique([tenantId, entity])
}
