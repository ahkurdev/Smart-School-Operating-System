  type        String
  capacity    Int?
  description String?
  location    String?
  isBookable  Boolean @default(true)

  createdAt DateTime @default(now())

  bookings FacilityBooking[]

  @@index([tenantId, type])
}

model FacilityBooking {
  id         String    @id @default(cuid())
  tenantId   String
