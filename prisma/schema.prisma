// ============================================================================
// ADMISSIONS / PPDB
// ============================================================================

model AdmissionPeriod {
  id             String        @id @default(cuid())
  tenantId       String
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  name            String
  description     String?
  openAt          DateTime
  closeAt         DateTime
  quota           Int?
  registrationFee Float?
  currency        String?
  status          AdmissionPeriodStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tracks       AdmissionTrack[]
  applications Application[]

  @@index([tenantId, status])
}

enum AdmissionPeriodStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

model AdmissionTrack {
  id       String          @id @default(cuid())
  tenantId String
  periodId String
  period   AdmissionPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  name              String
  code              String
  description       String?
  quota             Int?
  requiresTest      Boolean @default(false)
  requiresInterview Boolean @default(false)
  eligibilityRules  Json    @default("{}")

  createdAt DateTime @default(now())

  applications Application[]

  @@unique([periodId, code])
}

model ApplicationForm {
  id        String  @id @default(cuid())
  tenantId  String
  periodId  String
  name      String
  isDefault Boolean @default(true)

  createdAt DateTime @default(now())

  fields ApplicationField[]

  @@index([tenantId, periodId])
}

model ApplicationField {
  id       String          @id @default(cuid())
  tenantId String
  formId   String
  form     ApplicationForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  key           String
  label         String
  type          ApplicationFieldType
  required      Boolean              @default(false)
  placeholder   String?
  helpText      String?
  options       Json                 @default("[]")
  validation    Json                 @default("{}")
  conditionalOn Json                 @default("{}")
  sequence      Int                  @default(0)
  section       String?

  @@index([formId, sequence])
}

enum ApplicationFieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  EMAIL
  PHONE
  DATE
  SELECT
  MULTI_SELECT
  CHECKBOX
  RADIO
  FILE
  IMAGE
  ADDRESS
  GUARDIAN
  PREVIOUS_SCHOOL
  CUSTOM
}

model Applicant {
  id       String  @id @default(cuid())
  tenantId String
  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  fullName       String
  email          String?
  phone          String?
  birthDate      DateTime?
  gender         String?
  previousSchool String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications  Application[]
  studentId     String?       @unique
  originStudent Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([tenantId, email])
}

model Application {
  id          String          @id @default(cuid())
  tenantId    String
  applicantId String
  applicant   Applicant       @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  periodId    String
  period      AdmissionPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  trackId     String?
  track       AdmissionTrack? @relation(fields: [trackId], references: [id], onDelete: SetNull)

  applicationNumber String
  status            ApplicationStatus @default(DRAFT)
  currentStep       String?

  submittedAt      DateTime?
  verifiedAt       DateTime?
  verifiedByUserId String?

  score Float?
  rank  Int?

  decision         AdmissionDecisionType?
  decisionAt       DateTime?
  decisionByUserId String?
  decisionNotes    String?

  reRegisteredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values      ApplicationValue[]
  documents   ApplicationDocument[]
  decisionRow AdmissionDecision?

  @@unique([tenantId, applicationNumber])
  @@index([tenantId, status])
  @@index([periodId, status])
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_REVISION
  VERIFIED
  TEST_SCHEDULED
  INTERVIEW_SCHEDULED
  EVALUATED
  ACCEPTED
  WAITLISTED
  REJECTED
  RE_REGISTERED
  WITHDRAWN
}

enum AdmissionDecisionType {
  ACCEPTED
  WAITLISTED
  REJECTED
}

model ApplicationValue {
  id            String      @id @default(cuid())
  tenantId      String
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fieldId       String
  value         Json

  @@unique([applicationId, fieldId])
  @@index([tenantId])
}

model ApplicationDocument {
  id               String      @id @default(cuid())
  tenantId         String
  applicationId    String
  application      Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fileId           String
  documentType     String
  verified         Boolean     @default(false)
  verifiedByUserId String?
  notes            String?

  createdAt DateTime @default(now())

  @@index([applicationId])
}

model AdmissionDecision {
  id              String                @id @default(cuid())
  tenantId        String
  applicationId   String                @unique
  application     Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  decision        AdmissionDecisionType
  score           Float?
  notes           String?
  letterFileId    String?
  decidedByUserId String?
  createdAt       DateTime              @default(now())

  @@index([tenantId])
}

// ============================================================================
// LIBRARY
// ============================================================================

model LibraryItem {
  id            String          @id @default(cuid())
  tenantId      String
  isbn          String?
  title         String
  author        String?
  publisher     String?
  year          Int?
  category      String?
  type          LibraryItemType @default(PHYSICAL)
  description   String?
  coverFileId   String?
  // Digital library
  digitalFileId String?
  externalUrl   String?
  accessLevel   String          @default("public")
  tags          String[]        @default([])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  copies       LibraryCopy[]
  reservations LibraryReservation[]

  @@index([tenantId, title])
  @@index([tenantId, type])
}

enum LibraryItemType {
  PHYSICAL
  EBOOK
  DOCUMENT
  LINK
}

model LibraryCopy {
  id        String            @id @default(cuid())
  tenantId  String
  itemId    String
  item      LibraryItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  barcode   String
  status    LibraryCopyStatus @default(AVAILABLE)
  condition String?
  location  String?

  createdAt DateTime @default(now())

  loans LibraryLoan[]

  @@unique([tenantId, barcode])
  @@index([itemId, status])
}

enum LibraryCopyStatus {
  AVAILABLE
  ON_LOAN
  RESERVED
  LOST
  DAMAGED
  WITHDRAWN
}

model LibraryLoan {
  id             String      @id @default(cuid())
  tenantId       String
  copyId         String
  copy           LibraryCopy @relation(fields: [copyId], references: [id], onDelete: Cascade)
  studentId      String?
  student        Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  borrowerUserId String?

  borrowedAt DateTime   @default(now())
  dueAt      DateTime
  returnedAt DateTime?
  renewals   Int        @default(0)
  fineAmount Float      @default(0)
  finePaid   Boolean    @default(false)
  status     LoanStatus @default(ACTIVE)

  @@index([tenantId, status])
  @@index([studentId])
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

model LibraryReservation {
  id        String            @id @default(cuid())
  tenantId  String
  itemId    String
  item      LibraryItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  studentId String?
  student   Student?          @relation(fields: [studentId], references: [id], onDelete: SetNull)
  userId    String?
  status    ReservationStatus @default(PENDING)
  createdAt DateTime          @default(now())

  @@index([tenantId, status])
}

enum ReservationStatus {
  PENDING
  READY
  FULFILLED
  CANCELLED
  EXPIRED
}

// ============================================================================
// FINANCE
// ============================================================================

model FeeType {
  id            String  @id @default(cuid())
  tenantId      String
  name          String
  code          String
  description   String?
  defaultAmount Float?
  isRecurring   Boolean @default(false)
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())

  invoiceItems InvoiceItem[]

  @@unique([tenantId, code])
}

model Invoice {
  id         String    @id @default(cuid())
  tenantId   String
  studentId  String?
  student    Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  guardianId String?
  guardian   Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  invoiceNumber  String
  academicYearId String?
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  subtotal       Float         @default(0)
  discount       Float         @default(0)
  total          Float         @default(0)
  paidAmount     Float         @default(0)
  currency       String        @default("USD")
  status         InvoiceStatus @default(UNPAID)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([studentId])
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  WAIVED
  CANCELLED
  REFUNDED
}

model InvoiceItem {
  id          String   @id @default(cuid())
  tenantId    String
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeTypeId   String?
  feeType     FeeType? @relation(fields: [feeTypeId], references: [id], onDelete: SetNull)
  description String
  amount      Float
  quantity    Float    @default(1)

  @@index([invoiceId])
}

model Payment {
  id        String  @id @default(cuid())
  tenantId  String
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount           Float
  method           PaymentMethod @default(CASH)
  reference        String?
  gateway          String?
  gatewayRef       String?
  paidAt           DateTime      @default(now())
  status           PaymentStatus @default(COMPLETED)
  notes            String?
  recordedByUserId String?

  createdAt DateTime @default(now())

  @@index([tenantId, status])
  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  EWALLET
  GATEWAY
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

